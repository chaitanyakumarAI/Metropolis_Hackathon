# Private key of the deployer wallet (fund it with Monad testnet MON from https://faucet.monad.xyz)
DEPLOYER_PRIVATE_KEY=
# Comma-separated private keys for demo accounts used by scripts/seed.ts (3 creators + 2 fans)
DEMO_PRIVATE_KEYS=
# RPC used by Hardhat for monadTestnet (public endpoint from docs.monad.xyz, or your Alchemy URL)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Must equal the web app's SEAL_SECRET so seeded exclusive posts can be unlocked (32+ random chars)
SEAL_SECRET=
