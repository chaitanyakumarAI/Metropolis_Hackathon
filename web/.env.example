# "local" for a Hardhat node at 127.0.0.1:8545; leave empty for Monad Testnet (chain 10143)
NEXT_PUBLIC_CHAIN=
# Deployed FirstFan contract address and deployment block
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
# Comma-separated addresses seeded by the team; these get a visible "Demo account" badge
NEXT_PUBLIC_DEMO_ADDRESSES=
# Public repository link shown in the footer
NEXT_PUBLIC_REPO_URL=
# Server-only: key used to encrypt/decrypt exclusive posts (32+ random chars). Never expose to the client.
SEAL_SECRET=
# Server-only: optional Alchemy API key; when set, all server and proxied reads use Alchemy's Monad Testnet RPC
ALCHEMY_API_KEY=
# Server-only: fallback RPC when ALCHEMY_API_KEY is not set
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
